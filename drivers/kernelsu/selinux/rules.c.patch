*** Begin Patch
*** Add File: drivers/kernelsu/selinux/rules.c.patch
@@
+/* Ensure selinux symbols are available and avoid compiling SELinux-specific
+ * code when CONFIG_SECURITY_SELINUX is not enabled.
+ */
+#include <linux/types.h>
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/printk.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/rcupdate.h>
+#include <linux/version.h>
+#include <linux/lockdep.h>
+
+#include <linux/security.h>
+#include <linux/selinux.h>
+
+#if !defined(CONFIG_SECURITY_SELINUX)
+/* If SELinux is not enabled in this kernel config, provide lightweight
+ * stubs so this file can still compile.  The real functionality only
+ * applies when SELinux is present.
+ */
+static inline void apply_kernelsu_rules(void)
+{
+    pr_warn("kernelsu: SELinux disabled, skipping apply_kernelsu_rules\n");
+}
+
+static inline int handle_sepolicy(void __user *user_data, u64 data_len)
+{
+    return -ENOSYS;
+}
+
+#else /* CONFIG_SECURITY_SELINUX */
+
+/* --- Existing SELinux-enabled implementation follows --- */
*** End Patch